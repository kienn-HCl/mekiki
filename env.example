# mekiki serve に渡す環境変数の例。`cp env.example env && chmod 600 env` して値を埋め、
# systemd の EnvironmentFile= で読むか、`set -a; . ./env; set +a` してから起動する。
# AI連携・Discord・スケジュールなどの設定はWeb画面で行う（DBに保存される）。

# 待ち受けアドレスとデータディレクトリ
MEKIKI_ADDR=:8080
MEKIKI_DATA=/var/lib/mekiki

# Web画面のBasic認証。外部公開するなら必須（ユーザー名の既定は mekiki）
MEKIKI_USER=mekiki
MEKIKI_PASSWORD=change-me

# 任意。画面でAPIキーを入れない場合に使うAnthropic APIキー
# ANTHROPIC_API_KEY=sk-ant-...
