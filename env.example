# cron用の環境変数ファイル。`cp env.example env` して値を埋め、`chmod 600 env` すること。
# cron行で `. /path/to/mekiki/env && ...` として読み込む（SPEC §13）。

# mekikiのプロジェクトディレクトリ。result/bin/mekiki は起動時にここへcdする
# （cronは任意のカレントディレクトリで起動するため必須）
export MEKIKI_DIR=/path/to/mekiki

# claude CLIの認証情報 ~/.claude の解決に必要（cronでは未設定のことがある）
export HOME=/home/you

export RSS_DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
export NEWS_DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
