[Unit]
Description=mekiki - RSSの注目記事をAIが選んで要約するWebアプリ
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ユーザーは事前に作成: sudo useradd -r -m -d /var/lib/mekiki -s /usr/sbin/nologin mekiki
User=mekiki
Group=mekiki
WorkingDirectory=/var/lib/mekiki
ExecStart=/usr/local/bin/mekiki serve -addr :8080 -data /var/lib/mekiki
# 認証情報は `systemctl edit mekiki` で上書きファイルに書くか、EnvironmentFile で渡す
Environment=MEKIKI_PASSWORD=change-me
# EnvironmentFile=-/etc/mekiki/env
Restart=on-failure
RestartSec=5

StateDirectory=mekiki
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mekiki
Environment=HOME=/var/lib/mekiki
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
