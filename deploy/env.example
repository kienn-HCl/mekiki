# mekiki serve に渡す環境変数の例。コピーして値を埋め（chmod 600）、systemd の EnvironmentFile= で読むか、
# `set -a; . ./env; set +a` してから起動する。それ以外の設定はWeb画面か config.toml で行う。

MEKIKI_ADDR=:8080
MEKIKI_DATA=/var/lib/mekiki

# Basic認証。外部公開するなら必須
MEKIKI_USER=mekiki
MEKIKI_PASSWORD=change-me

# 画面でAPIキーを入れない場合に使う
# ANTHROPIC_API_KEY=sk-ant-...
